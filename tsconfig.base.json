{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowArbitraryExtensions": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@dexnest/action-registry": ["packages/action-registry/src/index.ts"],
      "@dexnest/autopilot-runtime": ["packages/autopilot-runtime/src/index.ts"],
      "@dexnest/foundation": ["packages/foundation/src/index.ts"],
      "@dexnest/dev-intelligence-contracts": ["packages/dev-intelligence-contracts/src/index.ts"],
      "@dexnest/dev-intelligence-contracts/standup": ["packages/dev-intelligence-contracts/src/standup.ts"],
      "@dexnest/dev-intelligence-contracts/issue-lifecycle": ["packages/dev-intelligence-contracts/src/issue-lifecycle.ts"],
      "@dexnest/dev-intelligence": ["packages/dev-intelligence/src/index.ts"],
      "@dexnest/dev-intelligence-store": ["packages/dev-intelligence-store/src/index.ts"],
      "@dexnest/dev-intelligence-store/testing": ["packages/dev-intelligence-store/src/testing.ts"],
      "@dexnest/standup": ["packages/standup/src/index.ts"],
      "@dexnest/reality-rpg": ["packages/reality-rpg/src/index.ts"],
      "@dexnest/foundation/testing": ["packages/foundation/src/testing.ts"],
      "@dexnest/local-db": ["packages/local-db/src/index.ts"],
      "@dexnest/shared-types": ["packages/shared-types/src/index.ts"],
      "@dexnest/today": ["packages/today/src/index.ts"],
      "@dexnest/shared-ui/tokens.css": ["packages/shared-ui/src/tokens.css"],
      "@dexnest/module-command": ["modules/command/src/index.tsx"],
      "@dexnest/module-dev": ["modules/dev/src/index.tsx"],
      "@dexnest/module-deck": ["modules/deck/src/index.ts"],
      "@dexnest/module-clipboard": ["modules/clipboard/src/index.ts"],
      "@dexnest/module-drop": ["modules/drop/src/index.ts"]
    }
  }
}
