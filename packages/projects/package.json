{
  "name": "@dexnest/projects",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Projects: every code project, its branches and how far they are from this PC. Read-only git; changes go through @dexnest/git-ops.",
  "exports": {
    ".": "./src/index.ts",
    "./domain": "./src/domain/index.ts"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types --experimental-sqlite --no-warnings test/*.test.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dexnest/foundation": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.14"
  }
}
