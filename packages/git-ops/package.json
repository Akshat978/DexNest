{
  "name": "@dexnest/git-ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The only DexNest code that runs git commands that change anything: preflight, preview, journal, run, verify, undo. Never force, never reset --hard, never clean, never rebase.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types --experimental-sqlite --no-warnings test/*.test.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dexnest/foundation": "workspace:*",
    "@dexnest/projects": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.14"
  }
}
