{
  "name": "dexnest",
  "version": "0.1.7",
  "private": true,
  "description": "DexNest offline-first desktop workspace.",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @dexnest/desktop dev",
    "build": "pnpm -r build",
    "package:win": "pnpm --filter @dexnest/desktop package:win",
    "package:win:folder": "pnpm --filter @dexnest/desktop package:win:folder",
    "package:win:installer": "pnpm --filter @dexnest/desktop package:win:installer",
    "package:win:all": "pnpm --filter @dexnest/desktop package:win:all",
    "dist:win": "pnpm --filter @dexnest/desktop dist:win",
    "rebuild:native": "pnpm --filter @dexnest/desktop rebuild:native",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @dexnest/autopilot-runtime test && pnpm --filter @dexnest/today test && pnpm --filter @dexnest/action-registry test && pnpm --filter @dexnest/desktop test"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
